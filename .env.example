# Copy this file to .env and fill in the values. Never commit .env.

# Postgres
POSTGRES_USER=trendpool
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trendpool
DATABASE_URL=postgres://trendpool:change-me@db:5432/trendpool

# General
TZ=Europe/Istanbul
NODE_ENV=production
LOG_LEVEL=info

# Worker
COLLECT_CRON=0 7,13,19 * * *
CLEANUP_CRON=30 3 * * *
SOURCE_TIMEOUT_MS=30000
CLUSTER_SIMILARITY_THRESHOLD=0.55
CLUSTER_WINDOW_HOURS=72
SCORE_HALF_LIFE_HOURS=24
RAW_ITEM_RETENTION_DAYS=30

# Dashboard login (README §6). All three are required, otherwise nobody can sign in.
# Password hash:  node scripts/hash-password.mjs
# Session secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DASHBOARD_USER=admin
DASHBOARD_PASSWORD_HASH=
SESSION_SECRET=
SESSION_MAX_AGE_DAYS=30
# Requests to http://localhost:3000 on the server itself skip login and API keys. Set false to disable.
AUTH_LOCALHOST_BYPASS=true
# Encrypts users' saved NVIDIA API keys (README §5c). 32+ random chars; changing it makes saved keys unreadable.
SECRETS_KEY=

# Sign-up confirmation emails (README §5d). Without MAIL_HOST the email is only logged.
APP_URL=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Trend Pool

# Post generation (each user adds their own NVIDIA key in Settings)
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_MS=60000

# API (/api/topics, needs an API key from the dashboard's Keys page except on localhost):
# cache identical requests for N seconds; max requests per minute per IP
API_CACHE_SECONDS=60
API_RATE_LIMIT_PER_MIN=60

# Niche (owner will fill in)
NICHE_DESCRIPTION=AI, software and tech news; Turkish tech and startup scene
NICHE_KEYWORDS=ai,llm,claude,openai,startup,yapay zeka,girişim

# LLM
LLM_PROVIDER=claude-cli
LLM_ENRICH_ENABLED=false
LLM_ENRICH_TOP_N=30
LLM_TIMEOUT_MS=120000
CLAUDE_CODE_OAUTH_TOKEN=

# Optional sources
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Reddit via our Devvit app (reddit-bridge/, see README)
REDDIT_DEVVIT_URL=
REDDIT_DEVVIT_TOKEN=
