# Copy this file to .env and fill in the values. Never commit .env.

# Postgres
POSTGRES_USER=trendpool
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trendpool
DATABASE_URL=postgres://trendpool:change-me@db:5432/trendpool

# General
TZ=Europe/Istanbul
NODE_ENV=production
LOG_LEVEL=info

# Worker
COLLECT_CRON=0 7,13,19 * * *
CLEANUP_CRON=30 3 * * *
SOURCE_TIMEOUT_MS=30000
CLUSTER_SIMILARITY_THRESHOLD=0.55
CLUSTER_WINDOW_HOURS=72
SCORE_HALF_LIFE_HOURS=24
RAW_ITEM_RETENTION_DAYS=30

# Niche (owner will fill in)
NICHE_DESCRIPTION=AI, software and tech news; Turkish tech and startup scene
NICHE_KEYWORDS=ai,llm,claude,openai,startup,yapay zeka,girişim

# LLM
LLM_PROVIDER=claude-cli
LLM_ENRICH_ENABLED=false
LLM_ENRICH_TOP_N=30
LLM_TIMEOUT_MS=120000
CLAUDE_CODE_OAUTH_TOKEN=

# Optional sources
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
